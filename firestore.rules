rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile document: users/{uid}
    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      // Creation happens once at registration, and only for the signed-in user's own uid.
      allow create: if request.auth != null && request.auth.uid == uid;
      // Profile documents are not deleted directly (deleting the auth account is separate).
      allow delete: if false;

      // A user's work records: users/{uid}/workRecords/{recordId}
      match /workRecords/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // Extra guardrails on write: keep the calculated fields consistent
        // and make sure a record can never be attributed to a different date
        // than its own document id (doc id == date, see services/workRecords.ts).
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.date is string
          && request.resource.data.hours is number
          && request.resource.data.hours >= 0 && request.resource.data.hours <= 24
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 59
          && request.resource.data.hourlyRate is number
          && request.resource.data.hourlyRate >= 0
          && request.resource.data.taxRate is number
          && request.resource.data.taxRate >= 0 && request.resource.data.taxRate <= 100;
      }

      // Per-month rate overrides: users/{uid}/monthSettings/{YYYY-MM}
      match /monthSettings/{monthId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.hourlyRate is number
          && request.resource.data.hourlyRate >= 0
          && request.resource.data.taxRate is number
          && request.resource.data.taxRate >= 0 && request.resource.data.taxRate <= 100;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
