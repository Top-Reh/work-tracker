rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile document: users/{uid}
    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      // Creation happens once at registration, and only for the signed-in user's own uid.
      allow create: if request.auth != null && request.auth.uid == uid;
      // Profile documents are not deleted directly (deleting the auth account is separate).
      allow delete: if false;

      // A user's work records: users/{uid}/workRecords/{recordId}
      // Each day-record holds a list of individual time entries plus day-level
      // totals (see services/workRecords.js). Security rules can't reach inside
      // each list element to check its own fields, so validation here is at the
      // aggregate/day level; the app itself is responsible for each entry's shape.
      match /workRecords/{recordId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.date is string
          && request.resource.data.entries is list
          && request.resource.data.totalHours is number
          && request.resource.data.totalHours >= 0
          && request.resource.data.grossSalary is number
          && request.resource.data.grossSalary >= 0
          && request.resource.data.taxAmount is number
          && request.resource.data.taxAmount >= 0
          && request.resource.data.netSalary is number;
      }

      // Per-month rate overrides: users/{uid}/monthSettings/{YYYY-MM}
      match /monthSettings/{monthId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.hourlyRate is number
          && request.resource.data.hourlyRate >= 0
          && request.resource.data.taxRate is number
          && request.resource.data.taxRate >= 0 && request.resource.data.taxRate <= 100;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
